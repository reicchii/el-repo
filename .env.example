# Names only. Values live in GitHub secrets and in a local .env that git ignores.
# Note: FastAPI/CLI scripts read OS environment variables directly (no python-dotenv auto-loader).

# Publishing / Cloud Deployment Tokens (do NOT commit real values)
HF_TOKEN=
HF_DATASET_REPO=
HF_SPACE=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Tier C only
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional local FastAPI / ML runtime settings (leave blank for defaults)
# Set PHANTOM_DISABLE_PREWARM=1 to disable background ML/M1 warmup at server startup
PHANTOM_DISABLE_PREWARM=
# Comma- or space-separated CSP frame-ancestors allowed when loading /?embed=1
PHANTOM_EMBED_FRAME_ANCESTORS=
