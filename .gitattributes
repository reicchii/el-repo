# Line endings: LF in the repository on every platform.
* text=auto eol=lf

# Binary data products. Never diffed or merged as text.
*.fits binary
*.fits.gz binary
*.parquet binary
*.npz binary

# Lockfiles are generated. GitHub collapses them in diffs.
uv.lock linguist-generated=true
web/pnpm-lock.yaml linguist-generated=true

# Append-only logs that every pull request touches. Git keeps both sides' lines on merge.
docs/ai-log.md merge=union
docs/decisions.md merge=union

# Docs and prompts count as documentation in GitHub's language bar.
docs/** linguist-documentation=true
prompts/** linguist-documentation=true

# Backend ML artefacts (Tier A/B) - binary, never diffed as text.
*.joblib binary
*.pkl binary
*.npz binary

# Generated benchmark packs: collapsed in diffs, excluded from language stats.
sample_packs/sources.json linguist-generated=true
sample_packs/cases.json linguist-generated=true
sample_packs/benchmark_report.json linguist-generated=true
